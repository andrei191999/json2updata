{
    "version": 1,
    "disable_existing_loggers": false,
    "handlers": {
        "null": {
            "class": "logging.NullHandler",
            "level": "CRITICAL"
        }
    },
    "root": {
        "level": "WARNING",
        "handlers": [
            "null"
        ]
    },
    "loggers": {
        "uvicorn": {
            "level": "WARNING",
            "handlers": [
                "null"
            ],
            "propagate": false
        },
        "uvicorn.error": {
            "level": "WARNING",
            "handlers": [
                "null"
            ],
            "propagate": false
        },
        "uvicorn.access": {
            "level": "WARNING",
            "handlers": [
                "null"
            ],
            "propagate": false
        }
    }
}