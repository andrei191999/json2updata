###############################################################################
# 1. Python artefacts
###############################################################################
__pycache__/
.pytest_cache/
*.egg-info/
*.egg-info/

###############################################################################
# 2. Node / front-end artefacts
###############################################################################
frontend/node_modules/
frontend/dist/
dist-ssr/
*.local

###############################################################################
# 3. Logs
###############################################################################
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

###############################################################################
# 4. App-specific generated / proprietary content
###############################################################################
# Raw invoice inputs (all flavours)
input_*/
input/*
!input/.gitkeep
input_local/
pdf_storage/*
!pdf_storage/.gitkeep
# Comparison files
backend/compare.py
frontend/src/components/compare.tsx
# Batch outputs
output/*
!output/.gitkeep
# Scratch data
data/*
!data/.gitkeep
# CSV spec, YAML defaults, PDFs we ship separately
resources/*
!resources/.gitkeep
testing*.py
tests/
pyproject.toml
pytest.ini
.venv/

###############################################################################
# 5. Editor / OS cruft
###############################################################################
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
